{
    "name": "iceburgcrm/iceburgcrm",
    "type": "project",
    "description": "Iceburg CRM is a metadata-driven CRM that allows you to quickly prototype different types of CRMs with dynamic modules, fields, relationships, and subpanels.",
    "keywords": ["framework", "crm", "vue3", "inertia", "iceburg", "iceburg crm", "cms", "composition api", "ai", "metadata", "laravel", "daisyui", "vue", "tailwinds", "llm"],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Robert Devenyi",
            "email": "rob@phpdeveloper.ca",
            "homepage": "https://www.software-developer.ca",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "http://docs.iceburg.ca"
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.2",
        "fakerphp/faker": "^1.23",
        "iamcal/sql-parser": "^0.4.0",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10",
        "maatwebsite/excel": "^3.1",
        "phpoffice/phpspreadsheet": "^1.9",
        "psr/simple-cache": "^2.0",
        "tightenco/ziggy": "^2.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16",
        "laravel/pint": "^1.23",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
            "psr-4": {
            "Tests\\": "tests/"
        },
        "classmap": [
            "database/seeders"
        ]
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
